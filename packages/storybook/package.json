{
  "name": "@nanoviews/storybook",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Nanoviews storybook renderer.",
  "author": "dangreen",
  "license": "MIT",
  "funding": "https://ko-fi.com/dangreen",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrigenSoftware/nanoviews.git",
    "directory": "packages/storybook"
  },
  "bugs": {
    "url": "https://github.com/TrigenSoftware/nanoviews/issues"
  },
  "keywords": [
    "storybook",
    "renderer",
    "ui",
    "nanoviews",
    "nano_kit"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./preset": "./src/preset.js",
    "./entry-preview": "./src/entryPreview.js"
  },
  "publishConfig": {
    "directory": "package",
    "linkDirectory": false
  },
  "files": [
    "src"
  ],
  "scripts": {
    "clear:package": "del ./package",
    "clear": "del ./package ./coverage",
    "prepublishOnly": "run clear:package clean-publish",
    "postpublish": "pnpm clear:package",
    "lint": "oxlint",
    "format": "oxlint --fix",
    "test": "run lint"
  },
  "peerDependencies": {
    "kida": "2.0.0-snapshot.20260830203546",
    "nanoviews": "workspace:^",
    "storybook": "^10.3.5"
  },
  "dependencies": {
    "@storybook/global": "^5.0.0",
    "type-fest": "^4.12.0"
  },
  "devDependencies": {
    "kida": "2.0.0-snapshot.20260830203546",
    "nanoviews": "workspace:^",
    "storybook": "catalog:"
  }
}
