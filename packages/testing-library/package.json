{
  "name": "@nanoviews/testing-library",
  "type": "module",
  "version": "1.0.0",
  "description": "Nanoviews testing utilities.",
  "author": "dangreen",
  "license": "MIT",
  "homepage": "https://github.com/TrigenSoftware/nanoviews/tree/main/packages/testing-library#readme",
  "funding": "https://ko-fi.com/dangreen",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrigenSoftware/nanoviews.git",
    "directory": "packages/testing-library"
  },
  "bugs": {
    "url": "https://github.com/TrigenSoftware/nanoviews/issues"
  },
  "keywords": [
    "testing",
    "test",
    "vitest",
    "ui",
    "nanoviews",
    "nano_kit"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./pure": "./src/pure.ts",
    "./vitest": "./src/vitest.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./pure": {
        "types": "./dist/pure.d.ts",
        "default": "./dist/pure.js"
      },
      "./vitest": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      }
    },
    "directory": "package",
    "linkDirectory": false
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clear:package": "del ./package",
    "clear:dist": "del ./dist",
    "clear": "del ./package ./dist ./coverage",
    "prepublishOnly": "run build clear:package clean-publish",
    "postpublish": "pnpm clear:package",
    "build:dist": "tsc -p tsconfig.build.json",
    "build": "run clear:dist build:dist",
    "lint": "oxlint",
    "format": "oxlint --fix",
    "test:types": "tsc --noEmit",
    "test": "run -p lint test:types"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=7",
    "nanoviews": "workspace:^",
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@types/node": "catalog:",
    "nanoviews": "workspace:^",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
